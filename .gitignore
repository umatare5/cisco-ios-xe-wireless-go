# Temporary files
tmp/
vendor/

# Test data files
# testdata is the name the go tool itself ignores, and it is the only one this
# tree writes. test_data covers captures left by older runs and can be dropped
# once none remain.
testdata/
test_data/

# Build artifacts
*.exe
*.dll
*.so
*.dylib

# Test binaries
*.test

# Coverage files
*.out
coverage/*
!coverage/report.out
!coverage/report.html

# Agent skills are local tooling; only the symlink to AGENTS.md is tracked
.claude/*
!.claude/CLAUDE.md

# IDE files
.idea/
*.swp
*.swo
.env
.envrc

# OS files
.DS_Store
Thumbs.db

# Example binaries
example/*/list_*
example/*/reload_*
