#!/usr/bin/env bash
#
# Branch guard. Secrets, format and lint are hooks of their own in .pre-commit-config.yaml;
# this one only keeps main free of direct commits.
#

set -euo pipefail

die() {
    printf 'no-commit-to-main: %s\n' "$*" >&2
    exit 1
}

# A merge, rebase or cherry-pick commits on the current branch legitimately, so the branch
# guard must stand aside for them or a conflicted merge cannot be completed without --no-verify.
sequencer_in_progress() {
    local git_dir
    git_dir=$(git rev-parse --git-dir)

    [[ -e "${git_dir}/MERGE_HEAD" ]] ||
        [[ -e "${git_dir}/CHERRY_PICK_HEAD" ]] ||
        [[ -d "${git_dir}/rebase-merge" ]] ||
        [[ -d "${git_dir}/rebase-apply" ]]
}

# Courtesy, not control: a hook is bypassable and uninstalled by default, so the real gate is
# branch protection on the remote.
assert_branch() {
    local branch

    if sequencer_in_progress; then
        return 0
    fi

    # A detached HEAD moves no branch, so there is nothing to protect.
    branch=$(git symbolic-ref --quiet --short HEAD) || return 0

    [[ "${branch}" != 'main' ]] || die 'main takes merges only - commit to a branch'
}

assert_branch
