{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD013": false,
    "MD024": { "siblings_only": true },
    // Two adjacent GitHub alerts need no blank line between them
    "MD028": false,
    "MD029": { "style": "ordered" },
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    "MD050": { "style": "asterisk" },
    "MD054": { "url_inline": false },
    "MD055": { "style": "leading_and_trailing" },
    "MD060": { "style": "aligned", "aligned_delimiter": true }
  },
  "overrides": [
    {
      "filter": [".github/ISSUE_TEMPLATE.md"],
      "combine": "merge",
      "config": {
        // A template body opens at H2 so the issue it seeds carries no stray title
        "MD041": false,
        "MD043": {
          "match_case": true,
          "headings": [
            "## SDK Version", "*",
            "## Description", "*",
            "## Actual Behavior", "*",
            "## Expected Behavior"
          ]
        }
      }
    },
    {
      "filter": [".github/PULL_REQUEST_TEMPLATE.md"],
      "combine": "merge",
      "config": {
        // A template body opens at H2 so the PR it seeds carries no stray title
        "MD041": false,
        "MD043": {
          "match_case": true,
          "headings": [
            "## WHAT", "*",
            "## WHY", "*",
            "## CHECKS"
          ]
        }
      }
    },
    {
      "filter": ["AGENTS.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Repository Instructions",
            "## Tech Stack", "*",
            "## Repository Structure", "*",
            "## Setup and Commands", "*",
            "## Code Style", "*",
            "## Testing Instructions", "*",
            "## Commits and PRs", "*",
            "## Domain Knowledge", "*",
            "## References"
          ]
        }
      }
    },
    {
      "filter": ["CODE_OF_CONDUCT.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Contributor Covenant Code of Conduct",
            "## Our Pledge", "*",
            "## Our Standards", "*",
            "## Enforcement Responsibilities", "*",
            "## Scope", "*",
            "## Enforcement", "*",
            "## Enforcement Guidelines", "*",
            "## Attribution"
          ]
        }
      }
    },
    {
      "filter": ["CONTRIBUTING.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Contribution Guide",
            "## How to Contribute", "*",
            "## Development", "*",
            "## Testing", "*",
            "## Scripts", "*",
            "## Change Review Process: For Maintainers", "*",
            "## Release Process: For Maintainers", "*",
            "## Typing Rules for Wire Values", "*",
            "## Reference", "*"
          ]
        }
      }
    },
    {
      "filter": ["README.md"],
      "combine": "merge",
      "config": {
        // The logo, badges and title block are HTML; the heading they carry is an <h1>
        "MD033": {
          "allowed_elements": ["a", "br", "details", "div", "h1", "img", "p", "picture", "source", "summary", "u"]
        },
        "MD041": { "allow_preamble": true },
        "MD043": {
          "match_case": true,
          "headings": [
            "## \u2728\ufe0f Key Features", "*",
            "## \ud83d\udce1 Supported Environment", "*",
            "## \ud83d\udce6 Installation", "*",
            "## \ud83d\ude80 Quick Start", "*",
            "## \ud83c\udf10 API Reference", "*",
            "## \ud83d\udd16 Usecases", "*",
            "## \ud83d\udce6 Used By", "*",
            "## \ud83e\udd1d Contributing", "*",
            "## \ud83d\ude4f Acknowledgments", "*",
            "## \ud83d\udcc4 License"
          ]
        }
      }
    },
    {
      "filter": ["docs/MAKE_REFERENCE.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Make Command Reference",
            "## Commands", "*",
            "## Examples", "*",
            "## About Underlying Scripts"
          ]
        }
      }
    },
    {
      "filter": ["docs/SCRIPT_REFERENCE.md"],
      "combine": "merge",
      "config": {
        // Sample output sits in <details>, and the H3 anchors give the summary table its link targets
        "MD033": { "allowed_elements": ["a", "details", "summary"] },
        "MD043": {
          "match_case": true,
          "headings": [
            "# Scripts Reference",
            "## Scripts", "*",
            "## Structure", "*",
            "## Development Scripts", "*",
            "## Testing Scripts", "*",
            "## Quality Scripts", "*",
            "## Help Script", "*"
          ]
        }
      }
    },
    {
      "filter": ["docs/SECURITY.md"],
      "combine": "merge",
      "config": {
        // The <a id> anchors give the checklist its link targets
        "MD033": { "allowed_elements": ["a"] },
        "MD043": {
          "match_case": true,
          "headings": [
            "# Security Guide",
            "## Checklist", "*",
            "## TLS Verification", "*",
            "## Token Handling", "*",
            "## Network & Access", "*",
            "## Logging", "*",
            "## Environment Isolation", "*",
            "## References"
          ]
        }
      }
    },
    {
      "filter": ["docs/TESTING.md"],
      "combine": "merge",
      "config": {
        // Sample output sits in <details>
        "MD033": { "allowed_elements": ["details", "summary"] },
        "MD043": {
          "match_case": true,
          "headings": [
            "# Testing",
            "## Testing Strategy", "*",
            "## Test Organization", "*",
            "## Prerequisites", "*",
            "## Running Tests", "*",
            "## Coverage Reports", "*",
            "## Appendix", "*"
          ]
        }
      }
    }
  ],
  "globs": ["**/*.md"],
  "gitignore": true,
  // Both are symlinks to AGENTS.md, which is linted on its own path
  "ignores": [".claude/CLAUDE.md", ".github/copilot-instructions.md"]
}
